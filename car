    // --- 6. YouTube Player & Playback Control ---
    function playVideoFromList(index, isAutoPlay = false) {
        if (!isAutoPlay) activePlaylist = [...displayedPlaylist];
        if (index < 0 || index >= activePlaylist.length) return;
        currentSongIndex = index;
        const item = activePlaylist[index];
        const vId = item.id ? item.id.videoId : item.videoId;
        const title = decodeHTMLEntities(item.snippet.title);
        const artist = item.snippet.channelTitle || "Rahul's Music";
        const thumbUrl = item.snippet.thumbnails.high ? item.snippet.thumbnails.high.url : (item.snippet.thumbnails.medium ? item.snippet.thumbnails.medium.url : '');

        playVideo(vId, title, artist, thumbUrl);
        addToRecentlyPlayed(item);
        updatePlayerFavState();

        // Highlight active playing item
        const allItems = document.querySelectorAll('.song-item');
        allItems.forEach((el, i) => {
            if (displayedPlaylist[i] && ((displayedPlaylist[i].id ? displayedPlaylist[i].id.videoId : displayedPlaylist[i].videoId) === vId)) {
