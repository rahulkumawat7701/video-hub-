    // --- 4. Render Songs Helper & Favorites / Recent Lists ---
    function isSongFavorite(videoId) {
        return favoritesList.some(item => (item.id && item.id.videoId === videoId) || item.videoId === videoId);
    }

    function toggleFavorite(songItem, btnElement) {
        const videoId = songItem.id ? songItem.id.videoId : songItem.videoId;
        const index = favoritesList.findIndex(item => (item.id && item.id.videoId === videoId) || item.videoId === videoId);
        
        if (index > -1) {
            favoritesList.splice(index, 1);
            if (btnElement) btnElement.classList.remove('active');
        } else {
            favoritesList.unshift(songItem);
            if (btnElement) btnElement.classList.add('active');
        }
        localStorage.setItem('my_favorites', JSON.stringify(favoritesList));
        updatePlayerFavState();
    }

    function addToRecentlyPlayed(songItem) {
        const videoId = songItem.id ? songItem.id.videoId : songItem.videoId;
        recentList = recentList.filter(item => (item.id ? item.id.videoId : item.videoId) !== videoId);
        recentList.unshift(songItem);
        if (recentList.length > 50) recentList.pop();
        localStorage.setItem('my_recent_played', JSON.stringify(recentList));
    }

